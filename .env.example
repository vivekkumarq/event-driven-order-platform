# Copy to .env and adjust. Every variable has a working default, so the stack starts without one.
#   cp .env.example .env
# .env is git-ignored; never commit real credentials.

# ---------------------------------------------------------------------------
# Host port mappings (docker compose only)
# ---------------------------------------------------------------------------
# Port on your machine that reaches the Kafka broker. Inside the compose network
# the services always use kafka:9092.
KAFKA_HOST_PORT=29092
POSTGRES_HOST_PORT=5432
ORDER_SERVICE_PORT=8080
INVENTORY_SERVICE_PORT=8082
KAFKA_UI_PORT=8090

# ---------------------------------------------------------------------------
# Kafka
# ---------------------------------------------------------------------------
# KRaft cluster id. Any valid base64 UUID; only used on first start of a fresh volume.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# Read by both services. Default when running a service outside Docker: localhost:9092
# (or localhost:29092 against the compose broker).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Consumer group. Defaults per service: order-service-group / inventory-service-group.
KAFKA_CONSUMER_GROUP=

# Consumer retry policy. Redeliveries after the first failure, then the record is
# parked on <topic>.DLT.
KAFKA_RETRY_MAX_ATTEMPTS=3
KAFKA_RETRY_BACKOFF_MS=1000

# Topic names. Both services must agree on these.
TOPIC_ORDER_CREATED=order-created-topic
TOPIC_ORDER_CANCELLED=order-cancelled-topic
TOPIC_INVENTORY_RESERVATION_RESULT=inventory-reservation-result-topic

# ---------------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------------
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform

# Per-service datasource. Left unset, each service uses its own in-memory H2 database:
#   order-service      jdbc:h2:mem:orderdb
#   inventory-service  jdbc:h2:mem:inventorydb
# Set SPRING_PROFILES_ACTIVE=prod to switch to the PostgreSQL profile.
DATASOURCE_URL=
DATASOURCE_USERNAME=
DATASOURCE_PASSWORD=

# ---------------------------------------------------------------------------
# Spring
# ---------------------------------------------------------------------------
# Empty for H2 dev mode, or 'prod' for PostgreSQL.
SPRING_PROFILES_ACTIVE=
# Per-service HTTP port. Defaults: 8080 (order) / 8082 (inventory).
SERVER_PORT=
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# order-service: transactional outbox relay
# ---------------------------------------------------------------------------
OUTBOX_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=50
# Publish attempts before a row is parked as FAILED for an operator.
OUTBOX_MAX_ATTEMPTS=10

# ---------------------------------------------------------------------------
# inventory-service: optimistic locking retries
# ---------------------------------------------------------------------------
# Attempts, including the first, before a reservation gives up on a concurrency
# conflict and lets the record go to the dead-letter topic.
RESERVATION_MAX_ATTEMPTS=5
RESERVATION_BACKOFF_MS=25
